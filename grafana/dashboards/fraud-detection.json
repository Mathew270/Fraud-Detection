{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Transactions Produced (rate/s)",
      "description": "Rate of transactions sent to Kafka by the producer",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(producer_transactions_produced_total[1m])",
          "legendFormat": "txn/s",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Fraud Detection (count / 5min)",
      "description": "Transactions evaluated by the fraud detector per minute, split by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(detector_transactions_processed_total{outcome=\"fraud\"}[5m])",
          "legendFormat": "fraud",
          "refId": "A"
        },
        {
          "expr": "increase(detector_transactions_processed_total{outcome=\"ok\"}[5m])",
          "legendFormat": "ok",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Fraud Reasons Breakdown (rate/s)",
      "description": "Rate of each fraud reason being triggered",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(detector_fraud_reasons_total[1m])",
          "legendFormat": "{{ reason }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Alerts Received by Severity (count / 5min)",
      "description": "Fraud alerts consumed by the alert service per minute, by severity level",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(alert_consumer_alerts_received_total[5m])",
          "legendFormat": "{{ severity }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Evaluation Latency (p50 / p95 / p99)",
      "description": "How long the fraud detector takes to evaluate a single transaction",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(detector_evaluation_duration_seconds_bucket[1m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(detector_evaluation_duration_seconds_bucket[1m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(detector_evaluation_duration_seconds_bucket[1m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Sliding Window Transaction Count",
      "description": "Most recent count of transactions inside the frequency detection window",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 4 }
            ]
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "detector_window_transaction_count",
          "legendFormat": "window count",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Producer Errors",
      "description": "Total Kafka produce delivery failures",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "producer_errors_total",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Redis Memory Usage",
      "description": "Current memory used by Redis (from redis-exporter)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used memory",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Redis Connected Clients",
      "description": "Number of active client connections to Redis",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["fraud-detection", "kafka", "redis"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fraud Detection Pipeline",
  "uid": "fraud-detection-pipeline",
  "version": 1
}
