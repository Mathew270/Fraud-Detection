{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Incoming Transaction Rate",
      "description": "Transactions generated per second across all producer replicas.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#2563eb", "mode": "fixed" },
          "unit": "reqps",
          "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(producer_transactions_produced_total[1m]))",
          "legendFormat": "txn/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Detector Outcomes",
      "description": "Transactions classified by the fraud detector per second.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": { "fillOpacity": 18, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fraud" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#dc2626", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ok" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#16a34a", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(detector_transactions_processed_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Fraud Rate (5m)",
      "description": "Share of processed transactions flagged as fraud over the last 5 minutes.",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "text": {},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#16a34a", "value": null },
              { "color": "#f59e0b", "value": 0.1 },
              { "color": "#dc2626", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(detector_transactions_processed_total{outcome=\"fraud\"}[5m])) / clamp_min(sum(rate(detector_transactions_processed_total[5m])), 0.001)",
          "legendFormat": "fraud rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Fraud Reasons (15m)",
      "description": "Fraud alerts grouped by the rule that triggered them over the last 15 minutes.",
      "type": "piechart",
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "huge_amount" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#dc2626", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "location_anomaly" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#ea580c", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "high_frequency_transactions" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#7c3aed", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(detector_fraud_reasons_total[15m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["fraud-detection", "transactions", "analytics"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Transaction Analytics",
  "uid": "transaction-analytics",
  "version": 2
}
