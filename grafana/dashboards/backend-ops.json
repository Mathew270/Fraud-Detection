{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Pipeline Throughput",
      "description": "Produced vs processed transactions per second. These should stay close when the pipeline is keeping up.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": { "fillOpacity": 12, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "produced" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#2563eb", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "processed" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#16a34a", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(producer_transactions_produced_total[1m]))",
          "legendFormat": "produced",
          "refId": "A"
        },
        {
          "expr": "sum(rate(detector_transactions_processed_total[1m]))",
          "legendFormat": "processed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Detector Latency p95",
      "description": "95th percentile time spent evaluating a transaction, including Redis state checks.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#7c3aed", "mode": "fixed" },
          "unit": "s",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(detector_evaluation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Producer Errors (5m)",
      "description": "Kafka delivery failures in the last 5 minutes. This should normally be zero.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "text": {},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#16a34a", "value": null },
              { "color": "#dc2626", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(producer_errors_total[5m]))",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Redis Memory Used",
      "description": "Current Redis memory footprint for detector state such as last transaction and recent transaction windows.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "text": {},
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#0891b2", "mode": "fixed" },
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "memory",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Redis Connected Clients",
      "description": "Current client connections to Redis from the running services and exporters.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "text": {},
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#ea580c", "mode": "fixed" },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["fraud-detection", "backend", "ops"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Backend Operations",
  "uid": "backend-ops",
  "version": 2
}
